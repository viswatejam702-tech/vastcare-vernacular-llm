# =====================================================================
# Vastcare Vernacular Healthcare LLM • Git Ignore Configuration
# =====================================================================

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.*.local

# Large Model Weights & Checkpoints (GGUF, PyTorch, HuggingFace)
output/
models/
*.gguf
*.bin
*.pt
*.pth
*.safetensors
*.onnx

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Logs & temporary run traces
logs/
*.log
scratch/

# OS Specific
.DS_Store
Thumbs.db
desktop.ini
